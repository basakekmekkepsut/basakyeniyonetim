# Firebase proje "basakyeniyonetim" konsolundan (Project settings > General > Your apps > SDK setup and configuration)
# kopyalanacak değerler. Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin. .env asla commit edilmez.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Yerel geliştirmede Firebase Emulator Suite'e bağlanmak için "true" yapın
# (firebase emulators:start ile Auth :9099 / Firestore :8080 üzerinde çalışır).
# Prod/gerçek proje ile çalışırken bu satırı silin veya "false" bırakın.
VITE_USE_EMULATOR=false
